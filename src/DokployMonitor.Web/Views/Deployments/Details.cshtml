@model DokployMonitor.Web.Models.DeploymentDetailsViewModel
@using DokployMonitor.Core.Deployments
@using DokployMonitor.Infrastructure.Identity
@{
    var d = Model.Deployment;
    ViewData["Title"] = $"{d.DisplayName} · Deployment";

    // Rozet yalnizca canli log akisi varken anlamli; aksi halde navbar'da gosterilmez.
    ViewData["ShowConnectionStatus"] = Model.CanStreamLive;

    var canAct = User.IsInRole(MonitorRoles.SuperAdmin);

    string StatusCss(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Running => "status-running",
        DeploymentStatus.Done => "status-done",
        DeploymentStatus.Error => "status-error",
        DeploymentStatus.Cancelled => "status-cancelled",
        _ => "status-unknown",
    };

    string StatusLabel(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Running => L["running"].Value,
        DeploymentStatus.Done => L["succeeded"].Value,
        DeploymentStatus.Error => L["ERROR"].Value,
        DeploymentStatus.Cancelled => L["cancelled"].Value,
        _ => L["unknown"].Value,
    };

    string EventTypeLabel(DeploymentEventType type) => type switch
    {
        DeploymentEventType.Started => L["Started"].Value,
        DeploymentEventType.StatusChanged => L["Status changed"].Value,
        DeploymentEventType.Finished => L["Finished"].Value,
        DeploymentEventType.WebhookReceived => L["Webhook received"].Value,
        _ => L["unknown"].Value,
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h4 mb-1">
            @d.DisplayName
            <span class="status-badge @StatusCss(d.Status) ms-2">@StatusLabel(d.Status)</span>
        </h1>
        <div class="small text-secondary">
            @d.ProjectName @(d.EnvironmentName is null ? "" : "/ " + d.EnvironmentName) · @d.ServiceType
            @if (d.IsPreviewDeployment)
            {
                <span class="badge text-bg-secondary">preview</span>
            }
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (canAct)
        {
            @if (d.Status.IsActive())
            {
                <form asp-action="Kill" asp-route-id="@d.DeploymentId" method="post"
                      data-confirm="@L["This deployment will be stopped. Are you sure?"]">
                    <button class="btn btn-sm btn-outline-danger" type="submit">@L["Stop"]</button>
                </form>
            }
            @if (d.ApplicationId is not null || d.ComposeId is not null)
            {
                <form asp-action="Redeploy" asp-route-id="@d.DeploymentId" method="post"
                      data-confirm="@L["The service will be redeployed. Are you sure?"]">
                    <button class="btn btn-sm btn-outline-secondary" type="submit">@L["Redeploy"]</button>
                </form>

                @* Replay: bu eski kayittan ayni servisin deploy'unu tekrarlar.
                   Dokploy belirli bir commit'i deploy edemedigi icin kaynagin guncel hali derlenir. *@
                <form asp-action="Replay" asp-route-id="@d.DeploymentId" method="post"
                      data-confirm="@L["This deployment will be replayed. Note: Dokploy builds the CURRENT source, not the old commit. Continue?"]">
                    <button class="btn btn-sm btn-outline-warning" type="submit"
                            title="@L["Trigger this deployment again from this record"]">@L["Replay"]</button>
                </form>
            }
        }
        else
        {
            <span class="small text-secondary align-self-center">@L["Deployment actions require the SuperAdmin role."]</span>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        @{
            // Build log yoksa container logu ekranin altina kadar uzasin.
            var fillContainerLog = !Model.Log.Available;
        }
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@L["Build Log"]</span>
                <div class="d-flex gap-3 align-items-center">
                    <span id="log-status" class="small text-secondary"></span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="autoscroll" checked>
                        <label class="form-check-label small" for="autoscroll">@L["Auto-scroll"]</label>
                    </div>
                </div>
            </div>
            <div class="card-body p-2">
                @if (!Model.Log.Available)
                {
                    <div class="alert alert-warning py-2 mb-0 small">
                        @(Model.Log.UnavailableReason ?? L["Log cannot be read."].Value)
                    </div>
                }
                else
                {
                    <div class="log-viewer log-viewer-fill" id="log-viewer">@foreach (var line in Model.Log.Lines)
{<div class="log-line">@line</div>}</div>
                }
            </div>
        </div>

        @* Container logu = calisan uygulamanin stdout/stderr cikisi (docker logs karsiligi).
           Build logundan farklidir; Engine API'sinden istege bagli olarak cekilir. *@
        <div class="card mt-3" id="container-log-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@L["Container Log"]<span class="small text-secondary">(docker logs @(d.AppName ?? d.ServiceName))</span>
                </span>
                <div class="d-flex gap-2 align-items-center">
                    <span id="container-log-status" class="small text-secondary">@L["not loaded"]</span>
                    <button type="button" class="btn btn-sm btn-outline-info" id="container-log-load">@L["Load"]</button>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="log-viewer @(fillContainerLog ? "log-viewer-fill" : "log-viewer-secondary")"
                     id="container-log-viewer"></div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">@L["Summary"]</div>
            <div class="card-body small">
                <dl class="row mb-0">
                    <dt class="col-5 text-secondary">@L["Title"]</dt>
                    <dd class="col-7">@(d.Title ?? "—")</dd>

                    <dt class="col-5 text-secondary">@L["Created"]</dt>
                    <dd class="col-7">@d.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</dd>

                    <dt class="col-5 text-secondary">@L["Started"]</dt>
                    <dd class="col-7">@(d.StartedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</dd>

                    <dt class="col-5 text-secondary">@L["Finished"]</dt>
                    <dd class="col-7">@(d.FinishedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</dd>

                    <dt class="col-5 text-secondary">@L["Duration"]</dt>
                    <dd class="col-7">
                        @if (d.Status.IsActive())
                        {
                            @* JS `new Date(...)` ile okunacak: kullanicinin kulturu (or. tr-TR)
                               "27.07.2026 10:12:08 +03:00" uretir ve ayrıştirilamaz (NaN).
                               "o" (round-trip) bicimi kulturden bagimsizdir. *@
                            <span data-elapsed-from="@((d.StartedAt ?? d.CreatedAt).ToString("o"))">—</span>
                        }
                        else
                        {
                            @(d.DurationSeconds is null ? "—" : TimeSpan.FromSeconds(d.DurationSeconds.Value).ToString(@"hh\:mm\:ss"))
                        }
                    </dd>

                    <dt class="col-5 text-secondary">@L["Server"]</dt>
                    <dd class="col-7">@(d.ServerName ?? L["local"].Value)</dd>

                    <dt class="col-5 text-secondary">@L["Deployment ID"]</dt>
                    <dd class="col-7"><code class="small">@d.DeploymentId</code></dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(d.ErrorMessage))
        {
            <div class="card mb-3 border-danger-subtle">
                <div class="card-header text-danger">@L["Error Message"]</div>
                <div class="card-body">
                    <pre class="small mb-0 text-danger" style="white-space:pre-wrap">@d.ErrorMessage</pre>
                    @if (d.ErrorSignatureHash is not null)
                    {
                        <a class="small" asp-controller="Errors" asp-action="Signature" asp-route-hash="@d.ErrorSignatureHash">
                            @L["Other deployments with the same error →"]
                        </a>
                    }
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">@L["Event History"]</div>
            <div class="card-body">
                @if (Model.Events.Count == 0)
                {
                    <div class="text-secondary small">@L["This deployment finished before monitoring started."]</div>
                }
                @foreach (var e in Model.Events)
                {
                    <div class="timeline-item">
                        <div class="small">
                            <strong>@EventTypeLabel(e.EventType)</strong>
                            @if (e.FromStatus is not null)
                            {
                                <span class="text-secondary">@StatusLabel(e.FromStatus.Value) → @(e.ToStatus is null ? L["unknown"].Value : StatusLabel(e.ToStatus.Value))</span>
                            }
                        </div>
                        <div class="small text-secondary">@e.OccurredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</div>
                    </div>
                }
            </div>
        </div>

        @if (Model.History.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@L["Recent Deployments of This Service"]</span>
                    <a class="text-decoration-none small text-secondary"
                       asp-action="Index" asp-route-q="@d.DisplayName">@L["full history →"]</a>
                </div>
                <ul class="list-group list-group-flush small">
                    @foreach (var h in Model.History)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center @(h.DeploymentId == d.DeploymentId ? "bg-body-secondary" : "")">
                            <span>
                                <span class="status-badge @StatusCss(h.Status)">@StatusLabel(h.Status)</span>
                                <a class="ms-2 text-decoration-none" asp-action="Details" asp-route-id="@h.DeploymentId">
                                    @h.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")
                                </a>
                                @if (h.DeploymentId == d.DeploymentId)
                                {
                                    <span class="badge text-bg-secondary ms-1">@L["this"]</span>
                                }
                            </span>
                            <span class="text-nowrap">
                                @if (h.DeploymentId != d.DeploymentId
                                     && (!string.IsNullOrWhiteSpace(h.LogPath) || !string.IsNullOrWhiteSpace(h.ArchivedLogPath)))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-info py-0 me-1"
                                            data-log-preview="@h.DeploymentId" data-log-label="@h.DisplayName">@L["Log"]</button>
                                }
                                <span class="text-secondary">
                                    @(h.DurationSeconds is null ? "—" : TimeSpan.FromSeconds(h.DurationSeconds.Value).ToString(@"mm\:ss"))
                                </span>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Model.ProjectHistory.Count > 0)
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@L["Other Deployments in Project"]</span>
                    <a class="text-decoration-none small text-secondary"
                       asp-action="Index" asp-route-project="@d.ProjectName">@L["filter project →"]</a>
                </div>
                <ul class="list-group list-group-flush small">
                    @foreach (var p in Model.ProjectHistory)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <span>
                                    <span class="status-badge @StatusCss(p.Status)">@StatusLabel(p.Status)</span>
                                    <a class="ms-2 text-decoration-none" asp-action="Details" asp-route-id="@p.DeploymentId">
                                        @p.DisplayName
                                    </a>
                                </span>
                                <span class="text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(p.LogPath) || !string.IsNullOrWhiteSpace(p.ArchivedLogPath))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info py-0 me-1"
                                                data-log-preview="@p.DeploymentId" data-log-label="@p.DisplayName">@L["Log"]</button>
                                    }
                                    <span class="text-secondary">@p.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                </span>
                            </div>
                            @if (p.EnvironmentName is not null)
                            {
                                <div class="text-secondary">@p.EnvironmentName</div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.__logStream = {
            deploymentId: '@d.DeploymentId',
            offset: @Model.Log.Offset,
            live: @(Model.CanStreamLive ? "true" : "false")
        };
    </script>
    <script src="~/js/deployment-log.js" asp-append-version="true"></script>
    <script src="~/js/container-log.js" asp-append-version="true"></script>
}
