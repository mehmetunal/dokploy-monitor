@using DokployMonitor.Infrastructure.Identity
@{
    ViewData["Title"] = "Yetkiniz Yok";
}

<div class="row justify-content-center">
    <div class="col-lg-6 text-center py-5">
        <h1 class="h4 mb-2">Bu islem icin yetkiniz yok</h1>
        <p class="text-secondary">
            Kullanici yonetimi ve deployment mudahalesi (Durdur / Yeniden Deploy)
            yalnizca <strong>@MonitorRoles.SuperAdmin</strong> rolundeki hesaplarda aciktir.
            Panolari, gecmisi, hatalari ve loglari gormeye devam edebilirsiniz.
        </p>
        <a class="btn btn-brand btn-sm" asp-controller="Dashboard" asp-action="Index">Canli panoya don</a>
    </div>
</div>
