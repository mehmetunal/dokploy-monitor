{
  "ConnectionStrings": {
    "Default": "Data Source=data/monitor.db"
  },
  "Dokploy": {
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "ForceLegacyDiscovery": false,
    "MaxParallelRequests": 4,
    "AllowInvalidCertificates": false
  },
  "Monitor": {
    "IdlePollSeconds": 15,
    "ActivePollSeconds": 2,
    "QueuePollSeconds": 5,
    "RecentCount": 50,
    "RetentionDays": 90,
    "FreshFinishWindowMinutes": 10
  },
  "Logs": {
    "MountPath": "/app/dokploy-logs",
    "HostPath": "/etc/dokploy/logs",
    "ArchivePath": "data/log-archive",
    "DefaultTailLines": 400,
    "PollIntervalMs": 750,
    "ArchiveFailedDeployments": true
  },
  "Docker": {
    "Enabled": true,
    "SocketPath": "/var/run/docker.sock",
    "ApiVersion": "v1.44",
    "TimeoutSeconds": 15,
    "MaxTailLines": 2000
  },
  "Webhook": {
    "Token": ""
  },
  "Auth": {
    "AdminEmail": "admin@trimango.local",
    "AdminPassword": "",
    "AdminDisplayName": "Yonetici",
    "MinimumPasswordLength": 8,
    "SessionDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Polly": "Error",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
