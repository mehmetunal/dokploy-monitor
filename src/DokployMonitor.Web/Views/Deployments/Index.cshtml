@model DokployMonitor.Web.Models.DeploymentHistoryViewModel
@using DokployMonitor.Core.Deployments
@{
    ViewData["Title"] = "Deployment Gecmisi";

    string StatusCss(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Running => "status-running",
        DeploymentStatus.Done => "status-done",
        DeploymentStatus.Error => "status-error",
        DeploymentStatus.Cancelled => "status-cancelled",
        _ => "status-unknown",
    };

    string StatusLabel(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Running => "calisiyor",
        DeploymentStatus.Done => "basarili",
        DeploymentStatus.Error => "HATA",
        DeploymentStatus.Cancelled => "iptal",
        _ => "bilinmiyor",
    };
}

<h1 class="h4 mb-3">Deployment Gecmisi</h1>

@{
    var filter = Model.Filter;
}

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-secondary mb-1" for="f-project">Proje</label>
                <select class="form-select form-select-sm" id="f-project" name="project">
                    <option value="">Tum projeler</option>
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project" selected="@(project == filter.Project)">@project</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1" for="f-status">Durum</label>
                <select class="form-select form-select-sm" id="f-status" name="status">
                    <option value="">Tum durumlar</option>
                    <option value="running" selected="@(filter.Status == "running")">Calisiyor</option>
                    <option value="done" selected="@(filter.Status == "done")">Basarili</option>
                    <option value="error" selected="@(filter.Status == "error")">Hatali</option>
                    <option value="cancelled" selected="@(filter.Status == "cancelled")">Iptal</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1" for="f-from">Baslangic</label>
                <input class="form-control form-control-sm" type="date" id="f-from" name="from"
                       value="@(filter.From?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1" for="f-to">Bitis</label>
                <input class="form-control form-control-sm" type="date" id="f-to" name="to"
                       value="@(filter.To?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-secondary mb-1" for="f-q">Arama</label>
                <input class="form-control form-control-sm" id="f-q" name="q" value="@filter.Q"
                       placeholder="Servis, proje veya hata metni" />
            </div>
        </div>
        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-sm btn-outline-light" type="submit">Filtrele</button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Temizle</a>
            <span class="ms-auto small text-secondary align-self-center">
                @Model.Deployments.Count kayit@(filter.IsEmpty ? "" : " (filtreli)")
            </span>
        </div>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning py-2 small" role="alert">
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:7rem">Durum</th>
                    <th>Servis</th>
                    <th style="width:8rem">Proje</th>
                    <th style="width:7rem">Tip</th>
                    <th style="width:11rem">Zaman</th>
                    <th style="width:7rem">Sure</th>
                    <th>Hata</th>
                    <th style="width:10rem">Log / Detay</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Deployments.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-secondary py-4">Kayit bulunamadi.</td></tr>
                }
                @foreach (var d in Model.Deployments)
                {
                    <tr class="@(d.Status.IsFailure() ? "row-failed" : "")">
                        <td><span class="status-badge @StatusCss(d.Status)">@StatusLabel(d.Status)</span></td>
                        <td>
                            <div class="fw-semibold">@d.DisplayName</div>
                            @if (d.EnvironmentName is not null)
                            {
                                <div class="small text-secondary">@d.EnvironmentName</div>
                            }
                        </td>
                        <td class="text-secondary">@d.ProjectName</td>
                        <td class="text-secondary">@d.ServiceType</td>
                        <td>@d.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>@(d.DurationSeconds is null ? "—" : TimeSpan.FromSeconds(d.DurationSeconds.Value).ToString(@"hh\:mm\:ss"))</td>
                        <td class="error-cell">
                            @if (!string.IsNullOrWhiteSpace(d.ErrorMessage))
                            {
                                <code>@DokployMonitor.Core.Dashboard.DeploymentRow.Summarize(d.ErrorMessage)</code>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (!string.IsNullOrWhiteSpace(d.LogPath) || !string.IsNullOrWhiteSpace(d.ArchivedLogPath))
                            {
                                <button type="button" class="btn btn-sm btn-outline-info me-1"
                                        data-log-preview="@d.DeploymentId" data-log-label="@d.DisplayName">Log</button>
                            }
                            <a class="btn btn-sm btn-outline-light" asp-action="Details" asp-route-id="@d.DeploymentId">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
