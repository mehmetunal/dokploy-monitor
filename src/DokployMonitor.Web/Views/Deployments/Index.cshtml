@model DokployMonitor.Web.Models.DeploymentHistoryViewModel
@using DokployMonitor.Core.Deployments
@{
    ViewData["Title"] = L["Deployment History"].Value;

    string StatusCss(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Running => "status-running",
        DeploymentStatus.Done => "status-done",
        DeploymentStatus.Error => "status-error",
        DeploymentStatus.Cancelled => "status-cancelled",
        _ => "status-unknown",
    };

    string StatusLabel(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Running => L["running"].Value,
        DeploymentStatus.Done => L["succeeded"].Value,
        DeploymentStatus.Error => L["ERROR"].Value,
        DeploymentStatus.Cancelled => L["cancelled"].Value,
        _ => L["unknown"].Value,
    };
}

<h1 class="h4 mb-3">@L["Deployment History"]</h1>

@{
    var filter = Model.Filter;
}

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-secondary mb-1" for="f-project">@L["Project"]</label>
                <select class="form-select form-select-sm" id="f-project" name="project">
                    <option value="">@L["All projects"]</option>
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project" selected="@(project == filter.Project)">@project</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1" for="f-status">@L["Status"]</label>
                <select class="form-select form-select-sm" id="f-status" name="status">
                    <option value="">@L["All statuses"]</option>
                    <option value="running" selected="@(filter.Status == "running")">@L["Running"]</option>
                    <option value="done" selected="@(filter.Status == "done")">@L["Succeeded"]</option>
                    <option value="error" selected="@(filter.Status == "error")">@L["Failed"]</option>
                    <option value="cancelled" selected="@(filter.Status == "cancelled")">@L["Cancelled"]</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1" for="f-from">@L["From"]</label>
                <input class="form-control form-control-sm" type="date" id="f-from" name="from"
                       value="@(filter.From?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1" for="f-to">@L["To"]</label>
                <input class="form-control form-control-sm" type="date" id="f-to" name="to"
                       value="@(filter.To?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-secondary mb-1" for="f-q">@L["Search"]</label>
                <input class="form-control form-control-sm" id="f-q" name="q" value="@filter.Q"
                       placeholder="@L["Service, project or error text"]" />
            </div>
            @* Baglanti filtresi yalnizca birden fazla Dokploy sunucusu tanimliysa anlamli. *@
            @if (Model.ConnectionNames.Count > 1)
            {
                <div class="col-md-3">
                    <label class="form-label small text-secondary mb-1" for="f-connection">@L["Server (connection)"]</label>
                    <select class="form-select form-select-sm" id="f-connection" name="connectionId">
                        <option value="">@L["All connections"]</option>
                        @foreach (var (id, name) in Model.ConnectionNames.OrderBy(pair => pair.Value))
                        {
                            <option value="@id" selected="@(id == filter.ConnectionId)">@name</option>
                        }
                    </select>
                </div>
            }
        </div>
        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-sm btn-outline-light" type="submit">@L["Filter"]</button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index">@L["Clear"]</a>
            
        </div>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning py-2 small" role="alert">
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:7rem">@L["Status"]</th>
                    <th>@L["Service"]</th>
                    <th style="width:8rem" class="d-none d-lg-table-cell">@L["Project"]</th>
                    <th style="width:7rem" class="d-none d-lg-table-cell">@L["Type"]</th>
                    <th style="width:11rem">@L["Time"]</th>
                    <th style="width:7rem">@L["Duration"]</th>
                    <th class="d-none d-md-table-cell">@L["Error"]</th>
                    <th style="width:10rem">@L["Log / Details"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Deployments.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-secondary py-4">@L["No records found."]</td></tr>
                }
                @foreach (var d in Model.Deployments)
                {
                    <tr class="@(d.Status.IsFailure() ? "row-failed" : "")">
                        <td><span class="status-badge @StatusCss(d.Status)">@StatusLabel(d.Status)</span></td>
                        <td>
                            <div class="fw-semibold">
                                @d.DisplayName
                                @if (Model.ConnectionNames.Count > 1 && d.ConnectionId is { } connectionId)
                                {
                                    <span class="badge text-bg-dark border border-secondary-subtle">
                                        @Model.ConnectionNames.GetValueOrDefault(connectionId, connectionId)
                                    </span>
                                }
                            </div>
                            @if (d.EnvironmentName is not null)
                            {
                                <div class="small text-secondary">@d.EnvironmentName</div>
                            }
                        </td>
                        <td class="text-secondary d-none d-lg-table-cell">@d.ProjectName</td>
                        <td class="text-secondary d-none d-lg-table-cell">@d.ServiceType</td>
                        <td>@d.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>@(d.DurationSeconds is null ? "—" : TimeSpan.FromSeconds(d.DurationSeconds.Value).ToString(@"hh\:mm\:ss"))</td>
                        <td class="error-cell d-none d-md-table-cell">
                            @if (!string.IsNullOrWhiteSpace(d.ErrorMessage))
                            {
                                <code>@DokployMonitor.Core.Dashboard.DeploymentRow.Summarize(d.ErrorMessage)</code>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (!string.IsNullOrWhiteSpace(d.LogPath) || !string.IsNullOrWhiteSpace(d.ArchivedLogPath))
                            {
                                <button type="button" class="btn btn-sm btn-outline-info me-1"
                                        data-log-preview="@d.DeploymentId" data-log-label="@d.DisplayName">@L["Log"]</button>
                            }
                            <a class="btn btn-sm btn-outline-light" asp-action="Details" asp-route-id="@d.DeploymentId">@L["Details"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_Pager", Model.Page)
