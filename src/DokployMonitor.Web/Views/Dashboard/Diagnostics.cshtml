@model DokployMonitor.Web.Models.DiagnosticsViewModel
@using Microsoft.Extensions.Options
@using DokployMonitor.Infrastructure.Identity
@using DokployMonitor.Infrastructure.Logs
@inject IOptions<LogOptions> LogOptions
@inject IOptions<DokployMonitor.Infrastructure.Docker.DockerOptions> DockerOptions
@{
    ViewData["Title"] = L["Diagnostics"].Value;
    var logs = LogOptions.Value;
    var docker = DockerOptions.Value;

    string Mark(bool ok) => ok ? "✔" : "✘";
    string Tone(bool ok) => ok ? "text-success" : "text-danger";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Setup Diagnostics"]</h1>
    @if (User.IsInRole(MonitorRoles.SuperAdmin))
    {
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Connections" asp-action="Index">@L["Manage connections"]</a>
    }
</div>

<div class="row g-3">
    <div class="col-lg-6">
        @if (Model.Connections.Count == 0)
        {
            <div class="alert alert-warning py-2 small">
                @L["No Dokploy connection is configured. Add one from the Connections screen, or provide the Dokploy__BaseUrl / Dokploy__ApiKey variables."]
            </div>
        }

        @foreach (var item in Model.Connections)
        {
            var connection = item.Connection;
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        @connection.Name
                        @if (!connection.Enabled)
                        {
                            <span class="badge text-bg-secondary ms-1">@L["disabled"]</span>
                        }
                    </span>
                    <code class="small text-secondary">@connection.BaseUrl</code>
                </div>
                <div class="card-body">
                    @if (item.Health is { } health)
                    {
                        <dl class="row mb-0">
                            <dt class="col-6">@L["Server reachable"]</dt>
                            <dd class="col-6 @Tone(health.IsReachable)">@Mark(health.IsReachable)</dd>

                            <dt class="col-6">@L["API key valid"]</dt>
                            <dd class="col-6 @Tone(health.IsAuthorized)">@Mark(health.IsAuthorized)</dd>

                            <dt class="col-6">deployment.allCentralized</dt>
                            <dd class="col-6 @Tone(health.SupportsCentralizedDeployments)">
                                @Mark(health.SupportsCentralizedDeployments)
                                @if (!health.SupportsCentralizedDeployments)
                                {
                                    <span class="small text-secondary d-block">@L["Falls back to per-service collection mode."]</span>
                                }
                            </dd>

                            <dt class="col-6">deployment.queueList</dt>
                            <dd class="col-6 @Tone(health.SupportsQueueList)">
                                @Mark(health.SupportsQueueList)
                                @if (!health.SupportsQueueList)
                                {
                                    <span class="small text-secondary d-block">@L["Queue view will be disabled."]</span>
                                }
                            </dd>
                        </dl>

                        @if (health.Error is not null)
                        {
                            <div class="alert alert-danger mt-3 mb-0 py-2 small">@health.Error</div>
                        }
                    }
                    else
                    {
                        <div class="small text-secondary">@L["Connection disabled; not checked."]</div>
                    }

                    <div class="small text-secondary mt-2">
                        @L["API key:"] <code>@connection.MaskedApiKey</code>
                        @if (connection.LastSyncAt is { } lastSync)
                        {
                            <span>· @L["last sync"]: @lastSync.ToLocalTime().ToString("dd.MM HH:mm:ss")</span>
                        }
                    </div>
                    @if (connection.LastSyncError is not null)
                    {
                        <div class="small text-warning mt-1">@L["Last sync error"]: @connection.LastSyncError</div>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">@L["Container Log (docker logs)"]</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-6">@L["Enabled in configuration"]</dt>
                    <dd class="col-6 @Tone(Model.Docker.Enabled)">@Mark(Model.Docker.Enabled)</dd>

                    <dt class="col-6">@L["Socket file"]</dt>
                    <dd class="col-6 @Tone(Model.Docker.SocketExists)">
                        @Mark(Model.Docker.SocketExists) <code>@docker.SocketPath</code>
                    </dd>

                    <dt class="col-6">Engine API</dt>
                    <dd class="col-6 @Tone(Model.Docker.Reachable)">
                        @Mark(Model.Docker.Reachable)
                        @if (Model.Docker.ServerVersion is not null)
                        {
                            <span class="text-secondary">Docker @Model.Docker.ServerVersion</span>
                        }
                    </dd>
                </dl>
                @if (Model.Docker.Message is not null)
                {
                    <div class="alert alert-warning mt-3 mb-0 py-2 small">@Model.Docker.Message</div>
                }
                @if (!Model.Docker.Reachable)
                {
                    <div class="small text-secondary mt-2">@L["For container logs, mount the socket into the container: /var/run/docker.sock:/var/run/docker.sock:ro. Without access the log viewer falls back to the build log."]</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">@L["Configuration"]</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">@L["Connection count"]</dt>
                    <dd class="col-7">
                        @Model.Connections.Count
                        (@L["{0} enabled", Model.Connections.Count(c => c.Connection.Enabled)])
                    </dd>

                    <dt class="col-5">@L["Log mount"]</dt>
                    <dd class="col-7">
                        @logs.MountPath
                        @if (Directory.Exists(logs.MountPath))
                        {
                            <span class="text-success">✔</span>
                        }
                        else
                        {
                            <span class="text-danger">@L["✘ not found"]</span>
                        }
                    </dd>

                    <dt class="col-5">@L["Dokploy log root"]</dt>
                    <dd class="col-7">@logs.HostPath</dd>

                    <dt class="col-5">@L["Cache"]</dt>
                    <dd class="col-7 @Tone(Model.Cache.Working)">
                        @Mark(Model.Cache.Working) @Model.Cache.Provider
                        @if (Model.Cache.UsesRedis)
                        {
                            <span class="badge text-bg-dark">Redis</span>
                        }
                        @if (Model.Cache.Error is not null)
                        {
                            <div class="small text-warning">@Model.Cache.Error</div>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">@L["Webhook Setup"]</div>
            <div class="card-body small text-secondary">
                @L["Define this URL under Dokploy → Settings → Notifications → Add Notification (provider: Custom):"]
                <pre class="mt-2 mb-0"><code>@($"{Context.Request.Scheme}://{Context.Request.Host}/api/webhooks/dokploy?token=<TOKEN>")</code></pre>
                <div class="mt-2">@L["The same URL works for every Dokploy server; the token is shared."]</div>
            </div>
        </div>
    </div>
</div>
