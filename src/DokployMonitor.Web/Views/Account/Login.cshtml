@model DokployMonitor.Web.Models.LoginInput
@{
    ViewData["Title"] = L["Sign in"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Sign in"] · Trimango @L["Monitor"]</title>
    <link rel="icon" href="~/img/trimango-icon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <main class="login-shell">
        <div class="login-card card">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <img src="~/img/trimango-icon.svg" alt="Trimango" class="login-logo" />
                    <div class="text-secondary small mt-2">@L["Monitor"]</div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form method="post" asp-action="Login">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="Email">@L["Email"]</label>
                        <input class="form-control" asp-for="Email" type="email" autocomplete="username"
                               autofocus placeholder="ornek@trimango.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="Password">@L["Password"]</label>
                        <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" />
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="RememberMe" type="checkbox" />
                        <label class="form-check-label small" asp-for="RememberMe">@L["Remember me"]</label>
                    </div>

                    <button class="btn btn-brand w-100" type="submit">@L["Log in"]</button>
                </form>
            </div>
        </div>
        <div class="text-center text-secondary small mt-3">@L["There is no sign-up screen; the first administrator account comes from server configuration."]</div>
    </main>
</body>
</html>
