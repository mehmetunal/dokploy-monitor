@using System.Globalization
@using DokployMonitor.Infrastructure.Identity
@using DokployMonitor.Web.Options
@using DokployMonitor.Web.Services
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    // Tema ilk render'da sunucudan yazilir; boylece yanlis temayla "flash" olmaz.
    var themePreference = UiPreferences.ReadTheme(Context.Request);
    var bootstrapTheme = UiPreferences.ToBootstrapTheme(themePreference);

    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var textDirection = LocalizationSetup.IsRightToLeft(currentCulture) ? "rtl" : "ltr";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    string NavClass(string target) =>
        string.Equals(controller, target, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";

    var isDiagnostics = string.Equals(controller, "Dashboard", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Diagnostics", StringComparison.OrdinalIgnoreCase);
    var isLiveDashboard = string.Equals(controller, "Dashboard", StringComparison.OrdinalIgnoreCase) && !isDiagnostics;

    string BottomClass(bool active) => active ? "bottom-nav-item active" : "bottom-nav-item";

    var isSuperAdmin = User.IsInRole(MonitorRoles.SuperAdmin);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    // Baglanti rozeti yalnizca canli baglanti kuran sayfalarda anlamli.
    var showConnectionStatus = ViewData["ShowConnectionStatus"] is true;

    var userLabel = User.FindFirst(MonitorClaims.DisplayName)?.Value ?? User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@textDirection" data-bs-theme="@bootstrapTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] · Trimango @L["Monitor"]</title>
    <link rel="icon" href="~/img/favicon.png" type="image/png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "has-bottom-nav" : null)">
    <nav class="navbar navbar-expand-lg border-bottom border-secondary-subtle mb-3">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand fw-semibold d-flex align-items-center gap-2"
               asp-controller="Dashboard" asp-action="Index">
                @* Yazisiz ikon: marka adi logoda degil, yanindaki metinde. *@
                <img src="~/img/brand-mark.png" alt="Trimango" class="brand-logo" />
                <span class="brand-suffix">@L["Monitor"]</span>
            </a>

            @* Masaustu: tum linkler. Mobil: yalnizca rozet / tema / dil (ana gezinme altta). *@
            <div class="d-none d-lg-flex navbar-nav me-auto">
                <a class="nav-link @(isLiveDashboard ? "active" : null)" asp-controller="Dashboard" asp-action="Index">@L["Live Dashboard"]</a>
                <a class="@NavClass("Deployments")" asp-controller="Deployments" asp-action="Index">@L["History"]</a>
                <a class="@NavClass("Errors")" asp-controller="Errors" asp-action="Index">@L["Error Analysis"]</a>
                <a class="nav-link @(isDiagnostics ? "active" : null)" asp-controller="Dashboard" asp-action="Diagnostics">@L["Diagnostics"]</a>
                @if (isSuperAdmin)
                {
                    <a class="@NavClass("Connections")" asp-controller="Connections" asp-action="Index">@L["Connections"]</a>
                    <a class="@NavClass("Users")" asp-controller="Users" asp-action="Index">@L["Users"]</a>
                    <a class="@NavClass("Translations")" asp-controller="Translations" asp-action="Index">@L["Translations"]</a>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 small ms-auto">
                @if (showConnectionStatus)
                {
                    <span id="connection-status" class="badge text-bg-secondary">@L["connecting…"]</span>
                }

                @* Tema: koyu / aydinlik / sistem. Secim cerezde tutulur, istemci hemen uygular. *@
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false" title="@L["Theme"]">
                        @(themePreference switch
                        {
                            ThemePreference.Light => "☀",
                            ThemePreference.Dark => "🌙",
                            _ => "◐",
                        })
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header">@L["Theme"]</h6></li>
                        <li><button class="dropdown-item" type="button" data-theme-option="System">◐ @L["System"]</button></li>
                        <li><button class="dropdown-item" type="button" data-theme-option="Dark">🌙 @L["Dark"]</button></li>
                        <li><button class="dropdown-item" type="button" data-theme-option="Light">☀ @L["Light"]</button></li>
                    </ul>
                </div>

                @* Dil: cerez yoksa tarayici/sistem dili kullanilir. *@
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false" title="@L["Language"]">
                        @LocalizationSetup.Flag(currentCulture) @currentCulture.ToUpperInvariant()
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end language-menu">
                        <li><h6 class="dropdown-header">@L["Language"]</h6></li>
                        @foreach (var culture in LocalizationSetup.Supported)
                        {
                            <li>
                                <form method="post" asp-controller="Preferences" asp-action="SetLanguage" class="m-0">
                                    <input type="hidden" name="culture" value="@culture.Code" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="dropdown-item @(culture.Code == currentCulture ? "active" : "")" type="submit">
                                        <span class="me-1">@culture.Flag</span>@culture.NativeName
                                        <span class="text-secondary small">@culture.Code</span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
                @if (isAuthenticated)
                {
                    <a class="text-secondary text-decoration-none d-none d-lg-inline"
                       asp-controller="Account" asp-action="ChangeCredentials"
                       title="@L["Change credentials"]">
                        @userLabel
                        @if (isSuperAdmin)
                        {
                            <span class="badge text-bg-warning ms-1">@MonitorRoles.SuperAdmin</span>
                        }
                    </a>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="m-0 d-none d-lg-inline">
                        <button class="btn btn-sm btn-outline-secondary" type="submit">@L["Sign out"]</button>
                    </form>
                }
            </div>
        </div>
    </nav>

    <main class="container-fluid px-3 px-lg-4 pb-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success py-2">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger py-2">@error</div>
        }
        @RenderBody()
    </main>

    @if (isAuthenticated)
    {
        <nav class="bottom-nav d-lg-none" aria-label="@L["Toggle navigation"]">
            <a class="@BottomClass(isLiveDashboard)" asp-controller="Dashboard" asp-action="Index">
                <svg class="bottom-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
                <span>@L["Live Dashboard"]</span>
            </a>
            <a class="@BottomClass(string.Equals(controller, "Deployments", StringComparison.OrdinalIgnoreCase))" asp-controller="Deployments" asp-action="Index">
                <svg class="bottom-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14M5 12h14M5 19h9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
                <span>@L["History"]</span>
            </a>
            <a class="@BottomClass(string.Equals(controller, "Errors", StringComparison.OrdinalIgnoreCase))" asp-controller="Errors" asp-action="Index">
                <svg class="bottom-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5m0 3h.01M10.3 4.2 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
                <span>@L["Error Analysis"]</span>
            </a>
            <button type="button" class="@BottomClass(isDiagnostics
                    || string.Equals(controller, "Connections", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(controller, "Translations", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase))"
                    data-bs-toggle="offcanvas" data-bs-target="#mobile-more" aria-controls="mobile-more">
                <svg class="bottom-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="19" cy="12" r="1.6" fill="currentColor"/></svg>
                <span>@L["More"]</span>
            </button>
        </nav>

        <div class="offcanvas offcanvas-bottom mobile-more-sheet d-lg-none" tabindex="-1" id="mobile-more"
             aria-labelledby="mobile-more-title">
            <div class="offcanvas-header py-2">
                <h2 class="offcanvas-title h6 mb-0" id="mobile-more-title">@L["More"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@L["Cancel"]"></button>
            </div>
            <div class="offcanvas-body pt-0">
                <div class="list-group list-group-flush">
                    <a class="list-group-item list-group-item-action @(isDiagnostics ? "active" : null)"
                       asp-controller="Dashboard" asp-action="Diagnostics">@L["Diagnostics"]</a>
                    @if (isSuperAdmin)
                    {
                        <a class="list-group-item list-group-item-action @(string.Equals(controller, "Connections", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                           asp-controller="Connections" asp-action="Index">@L["Connections"]</a>
                        <a class="list-group-item list-group-item-action @(string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                           asp-controller="Users" asp-action="Index">@L["Users"]</a>
                        <a class="list-group-item list-group-item-action @(string.Equals(controller, "Translations", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                           asp-controller="Translations" asp-action="Index">@L["Translations"]</a>
                    }
                    <a class="list-group-item list-group-item-action @(string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                       asp-controller="Account" asp-action="ChangeCredentials">
                        @L["Change credentials"]
                        @if (!string.IsNullOrWhiteSpace(userLabel))
                        {
                            <span class="text-secondary small d-block">@userLabel</span>
                        }
                    </a>
                </div>
                <form method="post" asp-controller="Account" asp-action="Logout" class="mt-3">
                    <button class="btn btn-outline-secondary w-100" type="submit">@L["Sign out"]</button>
                </form>
            </div>
        </div>
    }

    @await Html.PartialAsync("_LogPreviewModal")

    @* Istemci tarafi metinler de yerelleştirilmis gelir; JS sabit metin tasimaz. *@
    <script>
        window.dmI18n = @Html.Raw(Json.Serialize(new Dictionary<string, string>
        {
            ["running"] = L["running"].Value,
            ["succeeded"] = L["succeeded"].Value,
            ["ERROR"] = L["ERROR"].Value,
            ["cancelled"] = L["cancelled"].Value,
            ["unknown"] = L["unknown"].Value,
            ["just now"] = L["just now"].Value,
            ["min ago"] = L["min ago"].Value,
            ["h ago"] = L["h ago"].Value,
            ["d ago"] = L["d ago"].Value,
            ["live"] = L["live"].Value,
            ["reconnecting…"] = L["reconnecting…"].Value,
            ["connection closed"] = L["connection closed"].Value,
            ["could not connect"] = L["could not connect"].Value,
            ["fallback mode (polling)"] = L["fallback mode (polling)"].Value,
            ["connecting…"] = L["connecting…"].Value,
            ["completed"] = L["completed"].Value,
            ["live stream…"] = L["live stream…"].Value,
            ["stream closed"] = L["stream closed"].Value,
            ["stream interrupted — refresh the page"] = L["stream interrupted — refresh the page"].Value,
            ["could not start live stream"] = L["could not start live stream"].Value,
            ["loading…"] = L["loading…"].Value,
            ["No deployment is running right now."] = L["No deployment is running right now."].Value,
            ["No running deployment matches the filter."] = L["No running deployment matches the filter."].Value,
            ["No records."] = L["No records."].Value,
            ["No records match the filter."] = L["No records match the filter."].Value,
            ["No jobs waiting in the queue."] = L["No jobs waiting in the queue."].Value,
            ["No webhook notifications yet."] = L["No webhook notifications yet."].Value,
            ["No filter"] = L["No filter"].Value,
            ["Filter active"] = L["Filter active"].Value,
            ["records"] = L["records"].Value,
            ["The indicators above always cover all projects over 24 hours."] = L["The indicators above always cover all projects over 24 hours."].Value,
            ["shown (indicators are not filtered)"] = L["shown (indicators are not filtered)"].Value,
            ["container log (docker)"] = L["container log (docker)"].Value,
            ["build log"] = L["build log"].Value,
            ["last {0} lines"] = L["last {0} lines"].Value,
            ["Log file is empty."] = L["Log file is empty."].Value,
            ["Log cannot be read."] = L["Log cannot be read."].Value,
            ["could not fetch log"] = L["could not fetch log"].Value,
            ["server unreachable"] = L["server unreachable"].Value,
            ["container has not written any log yet"] = L["container has not written any log yet"].Value,
            @* Log satiri seviye rozetleri (bkz. site.js -> logLevel) *@
            ["info"] = L["info"].Value,
            ["warning"] = L["warning"].Value,
            ["error"] = L["error"].Value,
            ["success"] = L["success"].Value,
            ["Details"] = L["Details"].Value,
            ["Log"] = L["Log"].Value,
            ["All projects"] = L["All projects"].Value,
            ["Last sync"] = L["Last sync"].Value,
            ["Sync error"] = L["Sync error"].Value,
            ["Refresh"] = L["Refresh"].Value,
            ["{0}-{1} of {2}"] = L["{0}-{1} of {2}"].Value,
            ["Page {0} / {1}"] = L["Page {0} / {1}"].Value,
            ["First page"] = L["First page"].Value,
            ["Previous page"] = L["Previous page"].Value,
            ["Next page"] = L["Next page"].Value,
            ["Last page"] = L["Last page"].Value
        }));
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/log-preview.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
