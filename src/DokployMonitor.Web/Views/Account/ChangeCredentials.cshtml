@model DokployMonitor.Web.Models.ChangeCredentialsInput
@using Microsoft.Extensions.Options
@inject IOptions<DokployMonitor.Web.Options.AuthOptions> AuthOptions
@{
    ViewData["Title"] = L["Credentials"].Value;
    var forced = ViewData["Forced"] is true;
    var minimumLength = Math.Clamp(AuthOptions.Value.MinimumPasswordLength, 8, 64);
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="h4 mb-1">@L["Update Credentials"]</h1>

        @if (forced)
        {
            <div class="alert alert-warning py-2 small">@L["Your account was created with the default credentials. You must confirm this step once: enter a new email/password, or retype the same values to keep them."]<div class="mt-1">@L["The default password is published in the documentation, so changing it is recommended when the panel is reachable from the internet."]</div></div>
        }
        else
        {
            <p class="small text-secondary">@L["You can change your email and password here."]</p>
        }

        <div class="card">
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form method="post" asp-action="ChangeCredentials">

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="CurrentPassword">@L["Current password"]</label>
                        <input class="form-control" asp-for="CurrentPassword" type="password"
                               autocomplete="current-password" autofocus />
                    </div>

                    <hr class="border-secondary-subtle" />

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="NewEmail">@L["New email"]</label>
                        <input class="form-control" asp-for="NewEmail" type="email" autocomplete="username" />
                        @if (forced)
                        {
                            <div class="form-text small">@L["You may keep the same address."]</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="NewPassword">@L["New password"]</label>
                        <input class="form-control" asp-for="NewPassword" type="password" autocomplete="new-password" />
                        <div class="form-text small">@L["At least {0} characters; must contain upper case, lower case and a digit.", minimumLength]</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="ConfirmPassword">@L["New password (repeat)"]</label>
                        <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-brand" type="submit">@L["Save"]</button>
                        @if (!forced)
                        {
                            <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">@L["Cancel"]</a>
                        }
                    </div>
                </form>
            </div>
        </div>

        @if (forced)
        {
            <form method="post" asp-action="Logout" class="mt-3 text-center">
                <button class="btn btn-sm btn-link text-secondary" type="submit">@L["Sign out"]</button>
            </form>
        }
    </div>
</div>
