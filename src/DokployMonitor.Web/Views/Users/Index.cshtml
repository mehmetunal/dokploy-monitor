@model DokployMonitor.Web.Models.UserListViewModel
@using DokployMonitor.Infrastructure.Identity
@using Microsoft.Extensions.Options
@inject IOptions<DokployMonitor.Web.Options.AuthOptions> AuthOptions
@{
    ViewData["Title"] = L["Users"].Value;
    var input = Model.NewUser;
    var minimumLength = Math.Clamp(AuthOptions.Value.MinimumPasswordLength, 8, 64);
}

<h1 class="h4 mb-1">@L["Users"]</h1>
<p class="small text-secondary mb-3">@L["There is no self-service sign-up; accounts are created only by users with the SuperAdmin role. The Viewer role is read-only: it can see dashboards and logs but cannot stop or redeploy deployments."]</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger py-2 small" role="alert">
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">@L["Existing Users"] (@Model.Users.Count)</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["Email"]</th>
                            <th style="width:8rem">@L["Role"]</th>
                            <th style="width:7rem">@L["Status"]</th>
                            <th style="width:6rem"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@user.Email</div>
                                    @if (user.DisplayName is not null)
                                    {
                                        <div class="small text-secondary">@user.DisplayName</div>
                                    }
                                </td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge @(role == MonitorRoles.SuperAdmin ? "text-bg-warning" : "text-bg-secondary")">@role</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (user.LockedOut)
                                    {
                                        <span class="text-danger">@L["locked"]</span>
                                    }
                                    else if (user.MustChangeCredentials)
                                    {
                                        <span class="text-warning">@L["credentials pending"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">@L["active"]</span>
                                    }
                                    @if (user.IsCurrentUser)
                                    {
                                        <span class="badge text-bg-secondary">@L["you"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!user.IsCurrentUser)
                                    {
                                        <form method="post" asp-action="ToggleLock" asp-route-id="@user.Id" class="m-0">
                                            <button class="btn btn-sm btn-outline-secondary" type="submit">
                                                @(user.LockedOut ? "Ac" : "Kilitle")
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">@L["New User"]</div>
            <div class="card-body">
                <form method="post" asp-action="Create">

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="NewUser.Email">@L["Email"]</label>
                        <input class="form-control form-control-sm" asp-for="NewUser.Email" type="email" name="Email"
                               value="@input.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="NewUser.DisplayName">@L["Name (optional)"]</label>
                        <input class="form-control form-control-sm" asp-for="NewUser.DisplayName" name="DisplayName"
                               value="@input.DisplayName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="NewUser.Password">@L["Initial password"]</label>
                        <input class="form-control form-control-sm" asp-for="NewUser.Password" type="password" name="Password" />
                        <div class="form-text small">@L["At least {0} characters; must contain upper case, lower case and a digit.", minimumLength]</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="NewUser.Role">@L["Role"]</label>
                        <select class="form-select form-select-sm" asp-for="NewUser.Role" name="Role">
                            @foreach (var role in MonitorRoles.All)
                            {
                                <option value="@role" selected="@(role == input.Role)">@role</option>
                            }
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="NewUser.MustChangeCredentials" type="checkbox"
                               name="MustChangeCredentials" value="true" checked="@input.MustChangeCredentials" />
                        <label class="form-check-label small" asp-for="NewUser.MustChangeCredentials">
                            @L["Require credential change on first sign-in"]
                        </label>
                    </div>

                    <button class="btn btn-brand btn-sm w-100" type="submit">@L["Create"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
