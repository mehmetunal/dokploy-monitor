@model DokployMonitor.Web.Models.ChangeCredentialsInput
@using Microsoft.Extensions.Options
@inject IOptions<DokployMonitor.Web.Options.AuthOptions> AuthOptions
@{
    ViewData["Title"] = "Kimlik Bilgileri";
    var forced = ViewData["Forced"] is true;
    var minimumLength = Math.Clamp(AuthOptions.Value.MinimumPasswordLength, 8, 64);
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="h4 mb-1">Kimlik Bilgilerini Guncelle</h1>

        @if (forced)
        {
            <div class="alert alert-warning py-2 small">
                Hesap varsayilan kimlik bilgileriyle olusturuldu. Devam etmek icin
                <strong>e-posta ve parolanizi</strong> degistirmeniz gerekiyor.
            </div>
        }
        else
        {
            <p class="small text-secondary">E-posta ve parolanizi buradan degistirebilirsiniz.</p>
        }

        <div class="card">
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form method="post" asp-action="ChangeCredentials">

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="CurrentPassword">Mevcut parola</label>
                        <input class="form-control" asp-for="CurrentPassword" type="password"
                               autocomplete="current-password" autofocus />
                    </div>

                    <hr class="border-secondary-subtle" />

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="NewEmail">Yeni e-posta</label>
                        <input class="form-control" asp-for="NewEmail" type="email" autocomplete="username" />
                        @if (forced)
                        {
                            <div class="form-text small">Varsayilan adresten farkli olmali.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="NewPassword">Yeni parola</label>
                        <input class="form-control" asp-for="NewPassword" type="password" autocomplete="new-password" />
                        <div class="form-text small">En az @minimumLength karakter; buyuk harf, kucuk harf ve rakam icermeli.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" asp-for="ConfirmPassword">Yeni parola (tekrar)</label>
                        <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-brand" type="submit">Kaydet</button>
                        @if (!forced)
                        {
                            <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Vazgec</a>
                        }
                    </div>
                </form>
            </div>
        </div>

        @if (forced)
        {
            <form method="post" asp-action="Logout" class="mt-3 text-center">
                <button class="btn btn-sm btn-link text-secondary" type="submit">Cikis yap</button>
            </form>
        }
    </div>
</div>
