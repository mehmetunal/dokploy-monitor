{
  "ConnectionStrings": {
    "Default": "Data Source=data/monitor-dev.db"
  },
  "Dokploy": {
    "BaseUrl": "http://localhost:3000",
    "ApiKey": "dev-placeholder",
    "AllowInvalidCertificates": true
  },
  "Logs": {
    "MountPath": "data/dev-logs",
    "HostPath": "/etc/dokploy/logs",
    "ArchivePath": "data/log-archive"
  },
  "Docker": {
    "Enabled": true,
    "SocketPath": "/var/run/docker.sock"
  },
  "Webhook": {
    "Token": "dev-token-yerel-gelistirme"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnectionString": "",
    "InstanceName": "dokploy-monitor:",
    "DefaultSeconds": 10
  }
}
