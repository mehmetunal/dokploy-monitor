@{
    ViewData["Title"] = L["Error"].Value;
}

<div class="alert alert-danger">
    <h1 class="h4 mb-2">@L["Something went wrong"]</h1>
    <p class="text-secondary">@L["An unexpected error occurred. Check the application logs for details."]</p>
</div>

<a class="btn btn-outline-light" asp-controller="Dashboard" asp-action="Index">@L["Back to dashboard"]</a>
