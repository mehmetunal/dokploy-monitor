@*
    Liste ekranlarindan log onizleme. Tetikleyici: data-log-preview="<deploymentId>"
    (istege bagli data-log-label="<servis adi>"). Icerik /deployments/{id}/log ucundan gelir.
*@
<div class="modal fade" id="log-preview-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <div>
                    <h2 class="modal-title h6 mb-0" id="log-preview-title">Build Logu</h2>
                    <div class="small text-secondary" id="log-preview-status"></div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    @* Kaynak: container logu (docker logs) veya Dokploy'un build logu *@
                    <div class="btn-group btn-group-sm" role="group" aria-label="Log kaynagi">
                        <button type="button" class="btn btn-outline-light active"
                                data-log-source="docker">Container</button>
                        <button type="button" class="btn btn-outline-light"
                                data-log-source="build">Build</button>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-light" id="log-preview-refresh">Tazele</button>
                    <a class="btn btn-sm btn-outline-info" id="log-preview-details" href="#">Detay</a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
            </div>
            <div class="modal-body p-2">
                <div class="log-viewer" id="log-preview-viewer" style="max-height:70vh"></div>
            </div>
        </div>
    </div>
</div>
