@model DokployMonitor.Web.Models.ConnectionListViewModel
@{
    ViewData["Title"] = L["Connections"].Value;
    var input = Model.NewConnection;
    var editing = !string.IsNullOrWhiteSpace(input.Id);
}

<h1 class="h4 mb-1">@L["Dokploy Connections"]</h1>
<p class="small text-secondary mb-3">@L["Each connection is one Dokploy server and one API key. Synchronisation walks every enabled connection; each collected deployment record carries the connection it came from. Keys are stored in the database and shown masked."]</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger py-2 small" role="alert">
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">@L["Configured Connections"] (@Model.Connections.Count)</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["Name / Address"]</th>
                            <th style="width:7rem">@L["Records"]</th>
                            <th style="width:7rem">@L["Status"]</th>
                            <th style="width:11rem"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Connections.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">
                                @L["No connection yet. Add one using the form on the right."]
                            </td></tr>
                        }
                        @foreach (var connection in Model.Connections)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@connection.Name</div>
                                    <div class="small text-secondary">@connection.BaseUrl</div>
                                    <div class="small text-secondary"><code>@connection.MaskedApiKey</code></div>
                                </td>
                                <td class="small text-secondary">
                                    @L["{0} records", Model.DeploymentCounts.GetValueOrDefault(connection.Id)]
                                </td>
                                <td class="small">
                                    @if (!connection.Enabled)
                                    {
                                        <span class="text-secondary">@L["disabled"]</span>
                                    }
                                    else if (connection.LastSyncError is not null)
                                    {
                                        <span class="text-danger" title="@connection.LastSyncError">@L["error"]</span>
                                    }
                                    else if (connection.LastSyncAt is not null)
                                    {
                                        <span class="text-success">@L["running"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">@L["pending"]</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <form method="post" asp-action="Test" asp-route-id="@connection.Id" class="d-inline m-0">
                                        <button class="btn btn-sm btn-outline-info" type="submit">@L["Test"]</button>
                                    </form>
                                    <a class="btn btn-sm btn-outline-light"
                                       asp-action="Index" asp-route-edit="@connection.Id">@L["Edit"]</a>
                                    <form method="post" asp-action="Delete" asp-route-id="@connection.Id" class="d-inline m-0"
                                          data-confirm="@L["The connection will be deleted. Collected history is kept. Are you sure?"]">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">@L["Delete"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">@(editing ? "Baglantiyi Duzenle" : "Yeni Baglanti")</div>
            <div class="card-body">
                <form method="post" asp-action="Save">
                    <input type="hidden" name="Id" value="@input.Id" />

                    <div class="mb-3">
                        <label class="form-label small text-secondary" for="c-name">Ad</label>
                        <input class="form-control form-control-sm" id="c-name" name="Name" value="@input.Name"
                               placeholder="Uretim" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" for="c-url">@L["Address (panel root)"]</label>
                        <input class="form-control form-control-sm" id="c-url" name="BaseUrl" value="@input.BaseUrl"
                               placeholder="http://dokploy:3000" />
                        <div class="form-text small">@L["Do not append"] <code>/api</code> @L["to the end."]</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary" for="c-key">@L["API key"]</label>
                        <input class="form-control form-control-sm" id="c-key" name="ApiKey" type="password"
                               autocomplete="off" />
                        @if (editing)
                        {
                            <div class="form-text small">@L["Leave empty to keep the current key."]</div>
                        }
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-secondary" for="c-timeout">@L["Timeout (s)"]</label>
                            <input class="form-control form-control-sm" id="c-timeout" name="TimeoutSeconds"
                                   type="number" min="5" max="120" value="@input.TimeoutSeconds" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-secondary" for="c-parallel">@L["Concurrent requests"]</label>
                            <input class="form-control form-control-sm" id="c-parallel" name="MaxParallelRequests"
                                   type="number" min="1" max="16" value="@input.MaxParallelRequests" />
                        </div>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="c-enabled" name="Enabled" value="true"
                               checked="@input.Enabled" />
                        <label class="form-check-label small" for="c-enabled">@L["Enabled (included in sync)"]</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="c-cert" name="AllowInvalidCertificates"
                               value="true" checked="@input.AllowInvalidCertificates" />
                        <label class="form-check-label small" for="c-cert">@L["Allow self-signed certificates"]</label>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="c-legacy" name="ForceLegacyDiscovery"
                               value="true" checked="@input.ForceLegacyDiscovery" />
                        <label class="form-check-label small" for="c-legacy">@L["Force legacy collection mode"]</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-brand btn-sm" type="submit">@(editing ? "Kaydet" : "Ekle")</button>
                        @if (editing)
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">@L["Cancel"]</a>
                        }
                    </div>
                </form>
            </div>
        </div>

        <div class="small text-secondary mt-2">@L["The more connections you add, the more requests reach Dokploy: each connection is polled separately. Take this into account for quota and rate limits."]</div>
    </div>
</div>
