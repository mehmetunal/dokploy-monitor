@model DokployMonitor.Web.Models.ErrorAnalysisViewModel
@{
    ViewData["Title"] = "Hata Analizi";
}

<h1 class="h4 mb-1">Hata Analizi</h1>
<p class="small text-secondary mb-3">
    Hata mesajlari normalize edilerek (GUID, sayi, yol ve zaman damgalari temizlenerek) gruplanir;
    boylece ayni kok neden farkli servislerde de olsa tek satirda gorunur.
</p>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">En Cok Tekrar Eden Hatalar</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:4rem">Adet</th>
                            <th>Hata</th>
                            <th style="width:9rem">Son Gorulme</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Signatures.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-secondary py-4">Henuz gruplanmis hata yok.</td></tr>
                        }
                        @foreach (var s in Model.Signatures)
                        {
                            <tr>
                                <td><span class="badge text-bg-danger">@s.OccurrenceCount</span></td>
                                <td>
                                    <a class="text-decoration-none" asp-action="Signature" asp-route-hash="@s.Hash">
                                        <code class="text-danger-emphasis">@s.NormalizedMessage</code>
                                    </a>
                                    @if (s.LastServiceName is not null)
                                    {
                                        <div class="small text-secondary">son: @s.LastServiceName</div>
                                    }
                                </td>
                                <td class="small text-secondary">@s.LastSeenAt.ToLocalTime().ToString("dd.MM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Son Basarisiz Deploymentlar</div>
            <ul class="list-group list-group-flush">
                @if (Model.RecentFailures.Count == 0)
                {
                    <li class="list-group-item text-secondary">Kayit yok.</li>
                }
                @foreach (var f in Model.RecentFailures)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <a class="text-decoration-none fw-semibold"
                               asp-controller="Deployments" asp-action="Details" asp-route-id="@f.DeploymentId">
                                @f.DisplayName
                            </a>
                            <span class="small text-secondary">@f.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                        </div>
                        <div class="small text-secondary">@f.ProjectName</div>
                        @if (!string.IsNullOrWhiteSpace(f.ErrorMessage))
                        {
                            <div class="small text-danger text-truncate">
                                @DokployMonitor.Core.Dashboard.DeploymentRow.Summarize(f.ErrorMessage)
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
