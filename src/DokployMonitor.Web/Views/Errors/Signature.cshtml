@model IReadOnlyList<DokployMonitor.Core.Deployments.TrackedDeployment>
@{
    var signature = (DokployMonitor.Core.Deployments.ErrorSignature)ViewData["Signature"]!;
    ViewData["Title"] = L["Error Signature"].Value;
}

<h1 class="h5 mb-2">@L["Error Signature"]</h1>

<div class="card mb-3">
    <div class="card-body">
        <code class="text-danger">@signature.NormalizedMessage</code>
        <div class="small text-secondary mt-2">
            @L["seen {0} times", signature.OccurrenceCount] ·
            @L["first"]: @signature.FirstSeenAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ·
            @L["last"]: @signature.LastSeenAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        </div>
        <details class="mt-2">
            <summary class="small text-secondary">@L["Sample raw message"]</summary>
            <pre class="small mt-2 mb-0" style="white-space:pre-wrap">@signature.SampleMessage</pre>
        </details>
    </div>
</div>

<div class="card">
    <div class="card-header">@L["Affected Deployments"]</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>@L["Service"]</th>
                    <th style="width:10rem">@L["Project"]</th>
                    <th style="width:11rem">@L["Time"]</th>
                    <th style="width:6rem"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="fw-semibold">@d.DisplayName</td>
                        <td class="text-secondary">@d.ProjectName</td>
                        <td>@d.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-light"
                               asp-controller="Deployments" asp-action="Details" asp-route-id="@d.DeploymentId">@L["Details"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
