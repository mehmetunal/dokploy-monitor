@model DokployMonitor.Web.Models.ErrorAnalysisViewModel
@{
    ViewData["Title"] = L["Error Analysis"].Value;
    var filter = Model.Filter;

    var dayLabels = new Dictionary<int, string>
    {
        [0] = L["All time"].Value,
        [1] = L["Last 24 hours"].Value,
        [7] = L["Last 7 days"].Value,
        [30] = L["Last 30 days"].Value,
        [90] = L["Last 90 days"].Value,
        [365] = L["Last 1 year"].Value,
    };
}

<h1 class="h4 mb-1">@L["Error Analysis"]</h1>
<p class="small text-secondary mb-3">@L["Error messages are normalised (GUIDs, numbers, paths and timestamps are stripped) and grouped, so the same root cause appears on a single row even across different services. Counts and last-seen values are calculated from the filter below."]</p>

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-secondary mb-1" for="e-project">@L["Project"]</label>
                <select class="form-select form-select-sm" id="e-project" name="project">
                    <option value="">@L["All projects"]</option>
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project" selected="@(project == filter.Project)">@project</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-secondary mb-1" for="e-days">@L["Time range"]</label>
                <select class="form-select form-select-sm" id="e-days" name="days">
                    @foreach (var day in DokployMonitor.Web.Models.ErrorFilterValidator.AllowedDays)
                    {
                        <option value="@day" selected="@(day == filter.Days)">@dayLabels[day]</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <button class="btn btn-sm btn-outline-light" type="submit">@L["Filter"]</button>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index">@L["Clear"]</a>
                <span class="small text-secondary ms-2">
                    @L["{0} error groups", Model.Signatures.Count] · @L["{0} failed deployments", Model.RecentFailures.Count]
                </span>
            </div>
        </div>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning py-2 small" role="alert">
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">@L["Most Frequent Errors"]</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:4rem">@L["Count"]</th>
                            <th>@L["Error"]</th>
                            <th style="width:9rem">@L["Last Seen"]</th>
                            <th style="width:5rem">@L["Log"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Signatures.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">
                                @(filter.IsEmpty ? "Henuz gruplanmis hata yok." : "Filtreye uyan hata yok.")
                            </td></tr>
                        }
                        @foreach (var s in Model.Signatures)
                        {
                            <tr>
                                <td><span class="badge text-bg-danger">@s.Count</span></td>
                                <td>
                                    <a class="text-decoration-none" asp-action="Signature" asp-route-hash="@s.Hash">
                                        <code class="text-danger-emphasis">@s.NormalizedMessage</code>
                                    </a>
                                    @if (s.LastServiceName is not null)
                                    {
                                        <div class="small text-secondary">
                                            @L["last"]: @s.LastServiceName
                                            @if (s.LastProjectName is not null)
                                            {
                                                <span>· @s.LastProjectName</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="small text-secondary">@s.LastSeenAt.ToLocalTime().ToString("dd.MM HH:mm")</td>
                                <td>
                                    @if (s.LatestHasLog && s.LatestDeploymentId is not null)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info"
                                                data-log-preview="@s.LatestDeploymentId"
                                                data-log-label="@s.LastServiceName">@L["Log"]</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">@L["Recent Failed Deployments"]</div>
            <ul class="list-group list-group-flush">
                @if (Model.RecentFailures.Count == 0)
                {
                    <li class="list-group-item text-secondary">@L["No records."]</li>
                }
                @foreach (var f in Model.RecentFailures)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <a class="text-decoration-none fw-semibold"
                               asp-controller="Deployments" asp-action="Details" asp-route-id="@f.DeploymentId">
                                @f.DisplayName
                            </a>
                            <span class="text-nowrap">
                                @if (!string.IsNullOrWhiteSpace(f.LogPath) || !string.IsNullOrWhiteSpace(f.ArchivedLogPath))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-info py-0 me-1"
                                            data-log-preview="@f.DeploymentId" data-log-label="@f.DisplayName">@L["Log"]</button>
                                }
                                <span class="small text-secondary">@f.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                            </span>
                        </div>
                        <div class="small text-secondary">@f.ProjectName</div>
                        @if (!string.IsNullOrWhiteSpace(f.ErrorMessage))
                        {
                            <div class="small text-danger text-truncate">
                                @DokployMonitor.Core.Dashboard.DeploymentRow.Summarize(f.ErrorMessage)
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
